# ==============================================================================
# Switch Server Configuration (Primary Task & Multi-Agent Transport)
# ==============================================================================
SWITCH_SERVER_URL=http://127.0.0.1:52422
AGENT_REGISTRATION_TOKEN=
SWITCH_ROOM_ID=
AMBIENT_TRIAGE_POLICY=action_keywords # Options: addressed_only, action_keywords, all

# ==============================================================================
# Agent 1: TaskFlow Triage (The Ear - Ambient / High-Recall Classifier)
# ==============================================================================
SWITCH_TRIAGE_AGENT_NAME=taskflow-triage
SWITCH_TRIAGE_AGENT_ID=
SWITCH_TRIAGE_AGENT_API_KEY=

# ==============================================================================
# Agent 2: TaskFlow Worker (The Hands - Deliverable Drafter & Action Scaffolder)
# ==============================================================================
SWITCH_WORKER_AGENT_NAME=taskflow-worker
SWITCH_WORKER_AGENT_ID=
SWITCH_WORKER_AGENT_API_KEY=

# ==============================================================================
# Switch Trust Guardrails & Security Policy
# ==============================================================================
SWITCH_TRUST_API_KEY=
SWITCH_TRUST_GATEWAY_URL=https://api.switchagents.ai
SWITCH_TRUST_POLICY_ID=default
SWITCH_TRUST_REQUIRE_GUARDRAILS=false
SWITCH_TRUST_ALLOW_INSECURE_GATEWAY=false

# ==============================================================================
# LLM Providers & Configured Models (Gemini Primary, OpenAI & Anthropic Fallbacks)
# ==============================================================================
# At least ONE LLM API key is required. The gateway will automatically cascade:
# Gemini -> OpenAI -> Anthropic.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# LLM Retry & Backoff Configuration
LLM_MAX_RETRIES=3
LLM_INITIAL_BACKOFF=0.5

# Room Rate Limiting (LLM Cost DoS Prevention)
ROOM_RATE_LIMIT_ENABLED=true
ROOM_RATE_LIMIT_REQUESTS=15
ROOM_RATE_LIMIT_WINDOW_SECONDS=60.0

# ==============================================================================
# Ambient Triage & Context Window
# ==============================================================================
# "action_keywords" (recommended), "addressed_only", or "all".
AMBIENT_TRIAGE_POLICY=action_keywords
# Extra comma-separated keywords for your team's vocabulary.
AMBIENT_EXTRA_KEYWORDS=

# Triage starts with the static window and expands when the latest message is
# a fragment or needs earlier context. The expanded window is also forwarded to
# the worker, so a task split across several messages keeps its context.
TRIAGE_STATIC_WINDOW=5
TRIAGE_EXPANDED_WINDOW=15
# Ignore queued handoffs older than this after a restart.
HANDOFF_TTL_SECONDS=600

# ==============================================================================
# Repository Grounding
# ==============================================================================
# Local checkout the worker reads git history, changelog, and version from.
# Leave empty to use the current working directory when it is a git checkout,
# otherwise the TaskFlow project directory.
TASKFLOW_REPO_DIR=
# Repository URL shown to the model and attached as a Switch reference.
# Leave empty to use the git remote (or the project default).
TASKFLOW_REPO_URL=
# Optional per-room override (JSON):
# TASKFLOW_ROOM_REPOS={"8033d9bb-940c-404d-a6e7-add06d7740b0":{"dir":"/repos/app","url":"https://github.com/acme/app"}}
TASKFLOW_ROOM_REPOS={}

# ==============================================================================
# Timezone Configuration (for deadlines like 'Friday 5 PM' and Todoist sync)
# ==============================================================================
# Defaults to host/system timezone (e.g. Asia/Kolkata, IST, UTC).
# When conversational messages specify times without timezones (e.g. "Friday 5 PM"),
# this timezone is anchored into triage prompts, Switch task receipts, and Todoist sync.
TIMEZONE=

# ==============================================================================
# Optional: External Integrations (Switch tasks & room documents are PRIMARY)
# ==============================================================================
# Todoist is optional. If omitted, tasks are tracked natively within Switch rooms.
TODOIST_API_TOKEN=

# Optional: Slack Bot Token (only if bridging directly outside Switch)
SLACK_BOT_TOKEN=
