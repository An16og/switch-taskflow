# ==============================================================================
# Switch Server Configuration (Primary Task & Multi-Agent Transport)
# ==============================================================================
SWITCH_SERVER_URL=http://127.0.0.1:52422
AGENT_REGISTRATION_TOKEN=
SWITCH_ROOM_ID=
AMBIENT_TRIAGE_POLICY=action_keywords # Options: addressed_only, action_keywords, all

# ==============================================================================
# Agent 1: TaskFlow Triage (The Ear - Ambient / High-Recall Classifier)
# ==============================================================================
SWITCH_TRIAGE_AGENT_NAME=taskflow-triage
SWITCH_TRIAGE_AGENT_ID=
SWITCH_TRIAGE_AGENT_API_KEY=

# ==============================================================================
# Agent 2: TaskFlow Worker (The Hands - Deliverable Drafter & Action Scaffolder)
# ==============================================================================
SWITCH_WORKER_AGENT_NAME=taskflow-worker
SWITCH_WORKER_AGENT_ID=
SWITCH_WORKER_AGENT_API_KEY=

# ==============================================================================
# Switch Trust Guardrails & Security Policy
# ==============================================================================
SWITCH_TRUST_API_KEY=
SWITCH_TRUST_GATEWAY_URL=https://api.switchagents.ai
SWITCH_TRUST_POLICY_ID=default
SWITCH_TRUST_REQUIRE_GUARDRAILS=false
SWITCH_TRUST_ALLOW_INSECURE_GATEWAY=false

# ==============================================================================
# LLM Providers (Gemini Primary, OpenAI & Anthropic Fallbacks)
# ==============================================================================
# At least ONE LLM API key is required. The gateway will automatically cascade:
# Gemini -> OpenAI -> Anthropic.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ==============================================================================
# Optional: External Integrations (Switch tasks & room documents are PRIMARY)
# ==============================================================================
# Todoist is optional. If omitted, tasks are tracked natively within Switch rooms.
TODOIST_API_TOKEN=

# Optional: Slack Bot Token (only if bridging directly outside Switch)
SLACK_BOT_TOKEN=
